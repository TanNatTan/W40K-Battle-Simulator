{
  "name": "autonomous-war-theater",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A modular browser-based autonomous battle and map simulator.",
  "scripts": {
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start.ps1",
    "check": "node scripts/check.mjs",
    "smoke": "node scripts/browser-smoke.mjs",
    "stress:12p": "node scripts/stress-12-player.mjs",
    "stress:12p:full": "node scripts/stress-12-player.mjs --speed=4 --spawn-radius=160 --full-roster",
    "test:economy:endurance": "node scripts/economy-endurance.mjs",
    "test:2v2:soak": "node scripts/performance-2v2-soak.mjs",
    "test:2v2:quick": "node scripts/performance-2v2-soak.mjs --quick",
    "test:alliance-evolution": "node scripts/alliance-evolution.mjs",
    "test:alliance-evolution:quick": "node scripts/alliance-evolution.mjs --quick --max-attempts=1",
    "test:chapter-evolution": "node scripts/chapter-ai-evolution.mjs",
    "test": "node --test"
  }
}
